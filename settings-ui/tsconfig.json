{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/bridge/**/*.ts"]
}
